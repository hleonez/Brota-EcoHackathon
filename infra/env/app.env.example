# Contract for the future API; not consumed by the PostgreSQL container.
# Inside Compose: db:5432. On the host: 127.0.0.1:DB_LOCAL_PORT.
# For an external provider, use its hostname, port and TLS requirements.
DB_HOST=db
DB_PORT=5432
DB_NAME=brota
# Create a restricted runtime role when the application's needs are known.
DB_USER=
DB_PASSWORD=
# Local trusted Docker network only; use verify-full + trusted CA externally.
DB_SSLMODE=disable
