# API running directly on the developer's machine.
# The chosen framework must explicitly load/map these variables.
PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
DB_HOST=127.0.0.1
# Match DB_LOCAL_PORT in infra/env/dev.env if changed.
DB_PORT=5432
DB_NAME=brota
# Fill with the future application's restricted role and its local password.
DB_USER=
DB_PASSWORD=
DB_SSLMODE=disable
