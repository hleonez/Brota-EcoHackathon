# Copy to bot/.env and fill in. Never commit bot/.env.
PORT=8090

# --- Meta · WhatsApp Cloud API (developers.facebook.com → your app → WhatsApp → API Setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# App settings → Basic → App Secret (validates X-Hub-Signature-256).
WHATSAPP_APP_SECRET=
# Any random string; type the same value in Meta's webhook settings.
WHATSAPP_VERIFY_TOKEN=
GRAPH_API_VERSION=v25.0
# true: do not call Meta; keep outgoing messages in memory (GET /dev/mensajes).
WHATSAPP_DRY_RUN=false
# true: use approved templates when a notice falls outside the 24 h window.
WHATSAPP_USAR_PLANTILLAS=false
PLANTILLAS_IDIOMA=es

# --- Brota API
BROTA_API_URL=http://localhost:8000
# Same value as BOT_SERVICE_TOKEN in api/.env
BOT_SERVICE_TOKEN=

# --- Notices loop
AVISOS_ACTIVOS=true
AVISOS_INTERVALO_SEGUNDOS=3

# --- Lab (local development only): http://localhost:8090/lab with simulated phones.
# Messages to simulated phones never go to Meta. Only answers requests from this machine.
LAB_ACTIVO=false

# --- Coordination. false (default): the coordinator works in the panel (web/coordinacion) and only
# gets a WhatsApp alert per new request. true: she can also assign and close from WhatsApp (backup).
COORDINACION_POR_WHATSAPP=false
# Public URL of the coordination panel, included in the alert (leave empty in local development).
PANEL_COORDINACION_URL=

# WhatsApp Business Account ID (API Setup). Used by: python -m app.meta plantillas
WHATSAPP_WABA_ID=

# --- Cloud (Render). The lab is not published. See docs/despliegue-nube.md.
# On brota-bot: WHATSAPP_DRY_RUN=false, AVISOS_ACTIVOS=true, LAB_ACTIVO=false.
# BROTA_API_URL is injected from the API's public Render URL. Do not copy localhost.
# PANEL_COORDINACION_URL is the panel origin (https, no trailing slash), set after Pages.
# Do not set TUNEL_METRICAS_URL. Register https://<brota-bot>.onrender.com/webhook once in Meta.
# WHATSAPP_TOKEN, WHATSAPP_PHONE_NUMBER_ID, WHATSAPP_APP_SECRET, WHATSAPP_VERIFY_TOKEN
# and WHATSAPP_WABA_ID are copied from this machine's bot/.env into Render, not into Git.
# BOT_SERVICE_TOKEN must be the same value as in api/.env.
