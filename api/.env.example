# API running directly on the developer's machine (copy to api/.env).
PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
DB_HOST=127.0.0.1
# Match DB_LOCAL_PORT in infra/env/dev.env if changed.
DB_PORT=5432
DB_NAME=brota
# Development: the bootstrap user from infra/env/dev.env and its secret file.
# Production: a restricted runtime role (see docs/integracion.md).
DB_USER=brota_admin
DB_PASSWORD=
DB_PASSWORD_FILE=../infra/secrets/dev-db-password.txt
DB_SSLMODE=disable

# Signing secret for operator sessions (generate a long random value).
JWT_SECRET=
# Shared token the WhatsApp bot sends as "Authorization: Bearer <token>".
BOT_SERVICE_TOKEN=
# pull: the bot reserves pending notices via /v1/canal/avisos/reservas.
# webhook: the API POSTs notices to BOT_WEBHOOK_URL, signed with BOT_WEBHOOK_SECRET.
AVISOS_MODO=pull
BOT_WEBHOOK_URL=
BOT_WEBHOOK_SECRET=
# Brisa conversations kept for Administration; older messages are deleted.
CONVERSACIONES_RETENCION_DIAS=30

# --- AI (Gemini, Google AI Studio: https://aistudio.google.com/apikey). Without a key, Brisa
# keeps working with lists and catalog synonyms. Never commit the real key.
GEMINI_API_KEY=
GEMINI_MODELO=gemini-3.5-flash-lite

# --- Cloud (Render + Neon). Never put real secrets in this file.
# DB_HOST is Neon's direct host (no "-pooler"). DB_SSLMODE=verify-full. DB_NAME=brota.
# DB_PASSWORD, JWT_SECRET, BOT_SERVICE_TOKEN and GEMINI_API_KEY are copied from this
# machine's api/.env into the Render service brota-api. See docs/despliegue-nube.md.
# CORS_ALLOWED_ORIGINS in production is the panel origin (https, no trailing slash).
# Leave it unset until Cloudflare Pages exists; an empty value blocks every origin.
# MIGRAR_AL_INICIAR=true and SEMBRAR_AL_INICIAR=true are set in render.yaml.
# SEED_PIN (4–12 digits) lives only in Render. It is not stored in this example.
